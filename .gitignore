```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Coverage
coverage/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Temporary files
tmp/
temp/
*.tmp

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# Parcel
.cache/

# Next.js
.next/

# Nuxt.js
.nuxt/

# NestJS CLI
nest-cli.json

# Optional package manager files
.pnpm-store/

# Local history
.history/
```
